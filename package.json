{
  "name": "rewallet-stellar-poc",
  "version": "1.0.0",
  "private": true,
  "description": "PoC: onboarding y pago patrocinado (fee-bump) en Stellar Testnet con arquitectura hexagonal",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "e2e:usdc-fee-bump-sozu": "ts-node src/labstellar/e2e-usdc-sozu-fee-bump.ts",
    "e2e:xlm-fee-bump-sponsored-reserves": "ts-node src/labstellar/e2e-xlm-sponsored-reserves-fee-bump.ts",
    "e2e:usdc-fee-bump-sponsored-reserves": "ts-node src/labstellar/e2e-usdc-sponsored-reserves-fee-bump.ts",
    "e2e:usdc-onramp-pollar": "ts-node src/labstellar/e2e-usdc-onramp-pollar.ts",
    "e2e:usdc-offramp-pollar": "ts-node src/labstellar/e2e-usdc-offramp-pollar.ts",
    "e2e:usdc-onramp-pollar-sdk": "ts-node src/labstellar/e2e-usdc-onramp-pollar-sdk.ts",
    "test": "vitest run",
    "test:integration": "vitest run --dir src/__tests__/integration",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@pollar/core": "^0.12.0",
    "@sozu/faucet": "^0.2.0",
    "@stellar/stellar-sdk": "^14.6.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
