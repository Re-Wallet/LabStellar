{
  "name": "rewallet-stellar-poc",
  "version": "1.0.0",
  "private": true,
  "description": "PoC: onboarding y pago patrocinado (fee-bump) en Stellar Testnet con arquitectura hexagonal",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "demo": "ts-node src/labstellar/index.ts",
    "sponsored": "ts-node src/labstellar/sponsored.ts",
    "sponsored:usdc": "ts-node src/labstellar/sponsored-usdc.ts",
