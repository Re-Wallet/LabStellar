    "test:integration": "vitest run --dir src/__tests__/integration",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.6.1",
    "@sozu/faucet": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0",
    "vitest": "^1.6.0"
  }
}
